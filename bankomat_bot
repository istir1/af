balance = 500 #Стартовый баланс
history = [] #История банкомата
isactive = False
pin = '3109'
kb = telebot.types.ReplyKeyboardMarkup(True)
tasks = ['Проверить баланс', 'Снять деньги','Пополнить счет','История операций']
kb.add(*tasks)

@bot.message_handler(commands=['start'],) # /start
def start(message):
    bot.send_message(message.chat.id, "Введите пинкод")

@bot.message_handler(func=lambda message: message.text == 'Проверить баланс')
def bal_check(message):
    if isactive:
        bot.send_message(message.chat.id, str(balance))
    else:
        start(message)

@bot.message_handler(func=lambda message: message.text == 'Снять деньги')
def withdraw(message):
    if isactive:
        bot.send_message(message.chat.id, "Какую сумму хотите снять?")
        bot.register_next_step_handler(message, step)
    else:
        start(message)
def step(message):
    global balance
    summ = int(message.text)
    if summ > balance:
        bot.send_message(message.chat.id,"Недостаточно средств")
        history.append(("Снятие, Ошибка! ", time.ctime()))
    else:
        balance -= summ
        bot.send_message(message.chat.id,"Операция прошла успешно")
        history.append(("Снятие ", summ, time.ctime()))

@bot.message_handler(func=lambda message: message.text == 'Пополнить счет')
def deposit(message):
    if isactive:
        bot.send_message(message.chat.id, "Какую сумму хотите пополнить?")
        bot.register_next_step_handler(message, step2)
    else:
        start(message)
def step2(message):
    global balance
    summ = int(message.text)
    balance += summ
    bot.send_message(message.chat.id,"Операция прошла успешно")
    history.append(("Пополнение ", summ, time.ctime()))

@bot.message_handler(func=lambda message: message.text == 'История операций')
def histo(message):
    if isactive:
        bot.send_message(message.chat.id, str(history))

@bot.message_handler(func=lambda message: True)
def enter(message):
    global isactive
    print(kb)
    if message.text == pin:
        if isactive == False:
            bot.send_message(message.chat.id, "Активировано", reply_markup=kb)
            isactive = True
        elif isactive == True:
            bot.send_message(message.chat.id, "Уже активировано")
    else:
        if isactive != True:
            start(message)

bot.polling()
